{
  "entities": {
    "Notification": {
      "title": "Notification",
      "description": "Real-time user notification and push alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 500 },
        "url": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["system", "welcome", "credit_task", "chat", "syndicate", "bonus"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "body", "createdAt"]
    },
    "PushDeviceToken": {
      "title": "PushDeviceToken",
      "description": "Registered FCM device token for web push",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "token": { "type": "string", "maxLength": 500 },
        "platform": { "type": "string", "enum": ["web", "android", "ios"] },
        "userAgent": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "token", "platform", "updatedAt"]
    },
    "AdminSetting": {
      "title": "AdminSetting",
      "description": "System-wide admin configurations including AI keys and feature flags",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 100 },
        "value": { "type": "string", "maxLength": 2000 },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "value", "updatedAt"]
    },
    "RealtimePostView": {
      "title": "RealtimePostView",
      "description": "Realtime analytics view tracker for posts and blogs",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "viewsCount": { "type": "number" },
        "lastViewedAt": { "type": "string" }
      },
      "required": ["postId", "viewsCount", "lastViewedAt"]
    },
    "WebRTCCall": {
      "title": "WebRTCCall",
      "description": "Real-time peer-to-peer audio and video call signaling document",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatar": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleeAvatar": { "type": "string" },
        "callType": { "type": "string", "enum": ["video", "audio"] },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "rejected", "busy", "missed"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "durationSeconds": { "type": "number" }
      },
      "required": ["callId", "callerId", "calleeId", "callType", "status", "createdAt"]
    },
    "CallLog": {
      "title": "CallLog",
      "description": "Log record for completed, missed, or rejected audio/video calls",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatar": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleeAvatar": { "type": "string" },
        "callType": { "type": "string", "enum": ["video", "audio"] },
        "status": { "type": "string", "enum": ["connected", "ended", "rejected", "missed"] },
        "durationSeconds": { "type": "number" },
        "participants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" }
      },
      "required": ["callId", "callerId", "calleeId", "callType", "status", "participants", "createdAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC network connectivity candidates for peer-to-peer connection establishment",
      "type": "object",
      "properties": {
        "candidate": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["candidate", "createdAt"]
    },
    "ContactGainEntry": {
      "title": "ContactGainEntry",
      "description": "Verified Nigerian business contact registered for daily phonebook compilation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 50 },
        "industry": { "type": "string", "maxLength": 100 },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "state", "createdAt"]
    },
    "ContactGainCampaign": {
      "title": "ContactGainCampaign",
      "description": "User created campaign to pay others for saving their business contact",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "title": { "type": "string", "maxLength": 120 },
        "contactName": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "contactWhatsapp": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 50 },
        "industry": { "type": "string", "maxLength": 100 },
        "rewardPerSave": { "type": "number" },
        "totalTarget": { "type": "number" },
        "completedSaves": { "type": "number" },
        "budgetCredits": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "contactName", "contactPhone", "rewardPerSave", "totalTarget", "status", "createdAt"]
    },
    "ContactGainProof": {
      "title": "ContactGainProof",
      "description": "Proof of contact saved submission with screenshot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "campaignTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rewardCredits": { "type": "number" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "rejectionReason": { "type": "string" }
      },
      "required": ["campaignId", "userId", "userName", "screenshotUrl", "status", "rewardCredits", "createdAt"]
    },
    "ContactGainDownload": {
      "title": "ContactGainDownload",
      "description": "Audit record of daily VCF/CSV downloads and credit reward claims",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "creditsAwarded": { "type": "number" },
        "downloadedAt": { "type": "string" }
      },
      "required": ["userId", "date", "creditsAwarded", "downloadedAt"]
    },
    "MarketplaceVerification": {
      "title": "MarketplaceVerification",
      "description": "Real-time automated and manual business verification submissions and badge status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "business_profile_id": { "type": "string" },
        "user_email": { "type": "string" },
        "account_type": { "type": "string", "enum": ["individual", "registered_business"] },
        "document_type": { "type": "string", "enum": ["NIN", "CAC", "DRIVERS_LICENSE", "PASSPORT", "VOTERS_CARD", "UNKNOWN"] },
        "document_number": { "type": "string" },
        "submitted_name": { "type": "string" },
        "registered_profile_name": { "type": "string" },
        "document_file_url": { "type": "string" },
        "status": { "type": "string", "enum": ["UNVERIFIED", "FLAGGED_FOR_MANUAL_REVIEW", "VERIFIED", "REJECTED"] },
        "verified_badge_granted": { "type": "boolean" },
        "match_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "submitted_at": { "type": "string" },
        "evaluated_at": { "type": "string" },
        "last_updated_at": { "type": "string" }
      },
      "required": ["id", "user_id", "account_type", "document_type", "document_number", "status", "verified_badge_granted", "submitted_at"]
    },
    "BusinessReview": {
      "title": "BusinessReview",
      "description": "Real verified customer reviews and ratings for merchant websites and public storefronts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "business_user_id": { "type": "string" },
        "reviewer_id": { "type": "string" },
        "reviewer_name": { "type": "string", "maxLength": 100 },
        "reviewer_email": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string", "maxLength": 2000 },
        "verified_purchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "business_user_id", "reviewer_name", "rating", "comment", "created_at"]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User push and in-app notifications"
    },
    "/push_devices/{deviceId}": {
      "schema": { "$ref": "#/entities/PushDeviceToken" },
      "description": "User registered push tokens"
    },
    "/admin_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AdminSetting" },
      "description": "Global settings and API keys configured by platform admin"
    },
    "/post_views/{postId}": {
      "schema": { "$ref": "#/entities/RealtimePostView" },
      "description": "Live real-time view counts per post or blog"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/WebRTCCall" },
      "description": "WebRTC active and past call signaling records"
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "Caller ICE network candidates"
    },
    "/calls/{callId}/calleeCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "Callee ICE network candidates"
    },
    "/call_logs/{logId}": {
      "schema": { "$ref": "#/entities/CallLog" },
      "description": "Call history records for incoming, outgoing, and missed calls"
    },
    "/contact_gain_entries/{entryId}": {
      "schema": { "$ref": "#/entities/ContactGainEntry" },
      "description": "Verified Nigerian entrepreneur contacts compiled in daily phonebook"
    },
    "/contact_gain_campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/ContactGainCampaign" },
      "description": "Save My Contact promotional campaigns"
    },
    "/contact_gain_proofs/{proofId}": {
      "schema": { "$ref": "#/entities/ContactGainProof" },
      "description": "Proof submissions for saving contacts"
    },
    "/contact_gain_downloads/{downloadId}": {
      "schema": { "$ref": "#/entities/ContactGainDownload" },
      "description": "User daily download logs and reward tracking"
    },
    "/marketplace_verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/MarketplaceVerification" },
      "description": "Live business identity submissions, automated evaluations and verified status"
    },
    "/business_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/BusinessReview" },
      "description": "Real verified customer reviews and star ratings for merchants and business websites"
    }
  }
}
